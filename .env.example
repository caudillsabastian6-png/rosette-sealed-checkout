# Copy to .env at build time. SANDBOX / TEST credentials only.
# Never commit a filled .env. Never put production values in this project.

# PayPal — Developer Dashboard > Apps & Credentials > Sandbox > "Card Cauldron Rosette"
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# OPTIONAL — PayPal sandbox BUYER (Personal account) sign-in, from
# Developer Dashboard > Sandbox > Accounts. Reserved for the Kernel
# browser-persona approval driver (INTEGRATIONS.md §1.1, RISKS.md §4).
# Leave EMPTY to use the standard buyer-redirect approval: the demo
# shows PayPal's own approve link and the buyer clicks it, as in a real
# integration. Sandbox-only — never a real PayPal password.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# Channel3 — trychannel3.com/developers dashboard (apply promo PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

# Kernel — dashboard.onkernel.com/api-keys
KERNEL_API_KEY=

# eBay readers (optional; demo falls back to data/demo/ seeds without them)
# In the house these come from the registered connector layer, not raw keys.
EBAY_READ_ENABLED=false
